{
  "name": "ubos",
  "private": true,
  "version": "1.0.0-rc.1",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "dotenv -- turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yml,yaml,prisma}\"",
    "db:generate": "pnpm --filter @ubos/db exec prisma generate --schema prisma/schema.prisma",
    "db:push": "dotenv -- pnpm --filter @ubos/db exec prisma db push --schema prisma/schema.prisma",
    "db:migrate": "dotenv -- pnpm --filter @ubos/db exec prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "dotenv -- pnpm --filter @ubos/db exec prisma studio --schema prisma/schema.prisma",
    "test": "pnpm --filter @ubos/shared test",
    "release:report": "node scripts/generate-release-report.mjs",
    "media:demo": "node scripts/media-runtime-demo.mjs",
    "media:clock-demo": "pnpm --filter @ubos/media-plane build && node scripts/media-clock-demo.mjs",
    "media:decode-demo": "pnpm --filter @ubos/media-plane build && node scripts/video-decode-demo.mjs",
    "media:capture-demo": "pnpm --filter @ubos/media-plane build && node scripts/video-capture-demo.mjs",
    "media:audio-demo": "pnpm --filter @ubos/media-plane build && node scripts/audio-capture-decode-demo.mjs",
    "media:mixer-demo": "pnpm --filter @ubos/media-plane build && node scripts/audio-mixer-demo.mjs",
    "media:recording-demo": "pnpm --filter @ubos/media-plane build && node scripts/recording-pipeline-demo.mjs",
    "media:remote-demo": "pnpm --filter @ubos/media-plane build && node scripts/remote-production-demo.mjs",
    "desktop:demo": "pnpm --filter @ubos/desktop desktop:demo",
    "desktop:build": "pnpm --filter @ubos/desktop build",
    "collaboration:demo": "pnpm --filter @ubos/shared build && node scripts/collaboration-demo.mjs",
    "diagnostics:demo": "pnpm --filter @ubos/media-plane build && node scripts/diagnostics-demo.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}

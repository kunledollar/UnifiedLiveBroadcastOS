{
  "name": "@ubos/core",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node dist/observability/validation.js && node dist/incident-response/validation.js && node dist/capacity/validation.js && node dist/analytics/validation.js && node dist/change-management/validation.js && node dist/security-operations/validation.js && node dist/governance/validation.js && node dist/multi-tenant/validation.js",
    "validate:v5.11.1": "pnpm build && node dist/observability/validation.js",
    "validate:v5.11.2": "pnpm build && node dist/incident-response/validation.js",
    "validate:v5.11.3": "pnpm build && node dist/capacity/validation.js",
    "validate:v5.11.4": "pnpm build && node dist/analytics/validation.js",
    "validate:v5.11.5": "pnpm build && node dist/change-management/validation.js",
    "validate:v5.11.6": "pnpm build && node dist/security-operations/validation.js",
    "validate:v5.11.7": "pnpm build && node dist/governance/validation.js",
    "validate:v5.11.8": "pnpm build && node dist/multi-tenant/validation.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    },
    "./incident-response": {
      "types": "./dist/incident-response/index.d.ts",
      "import": "./dist/incident-response/index.js"
    },
    "./capacity": {
      "types": "./dist/capacity/index.d.ts",
      "import": "./dist/capacity/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js"
    },
    "./change-management": {
      "types": "./dist/change-management/index.d.ts",
      "import": "./dist/change-management/index.js"
    },
    "./security-operations": {
      "types": "./dist/security-operations/index.d.ts",
      "import": "./dist/security-operations/index.js"
    },
    "./governance": {
      "types": "./dist/governance/index.d.ts",
      "import": "./dist/governance/index.js"
    },
    "./multi-tenant": {
      "types": "./dist/multi-tenant/index.d.ts",
      "import": "./dist/multi-tenant/index.js"
    }
  }

{
  "name": "@ubos/web",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "clean": "rimraf .next",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",

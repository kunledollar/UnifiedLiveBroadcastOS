    "test": "tsc -p tsconfig.test.json && node --test dist-test/app/control-room/browsers/browser-workflows.test.js dist-test/app/control-room/command-center/command-center-logic.test.js dist-test/lib/native-runtime/ffmpeg-discovery.test.js dist-test/lib/native-runtime/ffmpeg-recording.test.js dist-test/lib/program-pipeline/program-ownership.test.js dist-test/app/control-room/workspace/scene-routing.test.js dist-test/app/control-room/scene-runtime-patching.test.js dist-test/app/control-room/production-scenes/production-scenes.test.js dist-test/app/control-room/workspaces/workspace-definition.test.js dist-test/app/control-room/workspaces/workspace-runtime.test.js dist-test/app/control-room/director/director-metadata.test.js dist-test/app/control-room/sources/source-metadata.test.js dist-test/app/control-room/social-fabric/social-metadata.test.js dist-test/app/control-room/intelligence-graph/ubosIntelligenceGraph.test.js dist-test/app/control-room/intelligence-graph/uigEventNormalizer.test.js dist-test/app/control-room/intelligence-graph/uigInferenceEngine.test.js dist-test/app/control-room/intelligence-graph/confidenceScoringEngine.test.js dist-test/app/control-room/intelligence-graph/temporalPatternEngine.test.js dist-test/app/control-room/intelligence-graph/predictiveEngine.test.js dist-test/app/control-room/intelligence-graph/insightFusionEngine.test.js dist-test/app/control-room/intelligence-graph/operatorGuidanceEngine.test.js dist-test/app/control-room/intelligence-graph/workspaceIntelligenceEngine.test.js dist-test/app/control-room/intelligence-graph/uiIntelligenceIntegrationLayer.test.js dist-test/app/control-room/intelligence-graph/ui-intelligence-typography.test.js dist-test/app/control-room/intelligence-graph/ui-intelligence-elevation.test.js dist-test/app/control-room/intelligence-graph/ui-intelligence-gradient.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:stability": "playwright test e2e/stability"
  },
  "dependencies": {
    "@ubos/db": "workspace:*",
    "@ubos/media-plane": "workspace:*",
    "@ubos/shared": "workspace:*",
    "@ubos/ui": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17"
  }
}

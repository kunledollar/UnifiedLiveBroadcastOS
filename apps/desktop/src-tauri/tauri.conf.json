{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unified Broadcast Operating System",
  "version": "1.0.0-rc.1",
  "identifier": "com.ubos.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --filter @ubos/web build",
    "devUrl": "http://localhost:3000/control-room",
    "frontendDist": "../../web/.next"
  },
  "app": {
    "windows": [
      {
        "title": "UBOS Control Room",
        "width": 1440,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "url": "/control-room"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "deb", "rpm", "appimage"],
    "category": "Video",
    "shortDescription": "Native desktop shell for the UBOS Control Room.",
    "longDescription": "Packages the existing web-based Unified Broadcast Operating System Control Room as a native Windows, macOS, and Linux application.",
    "copyright": "Copyright © 2026 UBOS"
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": []
    }
  }
}
